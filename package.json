{
  "name": "aurelian-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack application workspace for Aurelian Luxury High Jewelry",
  "scripts": {
    "start": "node backend/src/server.js",
    "build": "npm --prefix frontend run build",
    "dev": "npm --prefix backend run dev",
    "backend": "npm --prefix backend start",
    "backend:dev": "npm --prefix backend run dev",
    "frontend": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install",
    "install:all": "npm --prefix backend install && npm --prefix frontend install"
  },
  "keywords": ["jewelry", "luxury", "react", "express", "fullstack"],
  "author": "Aurelian Maison",
  "license": "ISC"
}
